<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Storymile" parent="Theme.Storymile.Base">
    <item name="android:navigationBarColor">@color/launch_background</item>
    <item name="android:windowLightNavigationBar">@bool/launch_light_system_bars</item>
    <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    <!-- A drawable prevents Android from falling back to the launcher icon. -->
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_empty_icon</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
  </style>
</resources>
